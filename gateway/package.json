{
  "name": "champiq-voice-gateway",
  "version": "1.0.0",
  "description": "ChampIQ Voice Gateway: headless CLI + HTTP gateway for AI calling agents, with ChampGraph memory layer and Canvas connector",
  "type": "module",
  "bin": {
    "champiq-voice": "./dist/cli/index.js"
  },
  "main": "./dist/server/app.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "serve": "node dist/cli/index.js serve",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
