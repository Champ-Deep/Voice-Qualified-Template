# ElevenLabs API (required - set these in Railway env vars)
VITE_VOICE_API_URL=https://api.elevenlabs.io/v1
VITE_VOICE_API_KEY=
VITE_AGENT_ID=
VITE_PHONE_NUMBER_ID=

# Redis (Railway provides REDIS_URL when you add a Redis plugin)
REDIS_URL=

# Optional: webhook signature verification
WEBHOOK_SECRET=

# Optional: restrict CORS origins (comma-separated)
FRONTEND_URL=
